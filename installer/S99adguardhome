#!/bin/sh
# S99adguardhome - AdGuard Home init script for KeeneticOS
# Repository: https://github.com/arl-spb/AdGuardHome-Keenetic
#
# Resolves Keenetic policy mark via RCI (/rci/show/ip/policy) once at
# service start, stores it in tmpfs for the netfilter hook to read.

# === Load integration config with safe defaults ===
: "${AG_LISTEN_IP:=127.0.0.1}"
: "${AG_LISTEN_PORT:=5354}"
: "${AG_POLICY_NAME:=adguard-clients}"
: "${WORKDIR:=/opt/etc/AdGuardHome}"
: "${CONF:=$WORKDIR/AdGuardHome.yaml}"
: "${LOG:=/opt/tmp/AdGuardHome.log}"
. /opt/etc/AdGuardHome/ag-keenetic.conf 2>/dev/null || true
# === End config loading ===

ENABLED=yes
PROCS=AdGuardHome
DESC="AdGuard Home"

# Runtime state (tmpfs)
RUNDIR="/tmp/.agh"
MARKFILE="$RUNDIR/policy-mark"

# Keenetic RCI (local)
RCI_URL="http://127.0.0.1:79/rci/show/ip/policy"
RCI_TIMEOUT=30

# Netfilter hook
HOOK="/opt/etc/ndm/netfilter.d/99-adguard-dns.sh"

# Auto-detect binary path (two possible locations)
[ -x "/opt/bin/AdGuardHome" ] && BIN="/opt/bin/AdGuardHome"
[ -x "$WORKDIR/AdGuardHome" ] && BIN="$WORKDIR/AdGuardHome"
[ -z "$BIN" ] && exit 1

export PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin

is_running() { pgrep -f "AdGuardHome" >/dev/null 2>&1; }

# --- Runtime dir -------------------------------------------------------------

init_rundir() {
    [ -d "$RUNDIR" ] || mkdir -p "$RUNDIR"
    chmod 700 "$RUNDIR" 2>/dev/null
}

clear_runtime() {
    rm -f "$MARKFILE"
    rmdir "$RUNDIR" 2>/dev/null
}

# --- Policy mark resolution --------------------------------------------------

# Wait until RCI /ip/policy returns a non-empty JSON document.
wait_for_rci_ready() {
    _t=0
    while [ "$_t" -lt "$RCI_TIMEOUT" ]; do
        _out=$(curl -s -m 2 "$RCI_URL" 2>/dev/null)
        case "$_out" in
            ""|"{}"|"[]") ;;
            \{*|\[*) return 0 ;;
        esac
        sleep 1
        _t=$((_t + 1))
    done
    return 1
}

# Resolve policy mark by description (case-insensitive).
# Prints mark without 0x prefix on success, empty on failure.
resolve_policy_mark() {
    curl -s -m 3 "$RCI_URL" 2>/dev/null \
        | jq -r --arg p "$AG_POLICY_NAME" \
            '.[] | select((.description // "") | ascii_downcase == ($p | ascii_downcase)) | .mark // empty' \
        2>/dev/null \
        | head -n 1
}

# --- DNS DNAT rules (remove on stop) -----------------------------------------

remove_dns_rules() {
    [ -r "$MARKFILE" ] || return 0
    _m=$(cat "$MARKFILE" 2>/dev/null)
    [ -z "$_m" ] && return 0
    _mh="0x$_m"
    _tgt="${AG_LISTEN_IP}:${AG_LISTEN_PORT}"
    iptables -t nat -D PREROUTING -p udp --dport 53 -m mark --mark "$_mh" -j DNAT --to-destination "$_tgt" 2>/dev/null
    iptables -t nat -D PREROUTING -p tcp --dport 53 -m mark --mark "$_mh" -j DNAT --to-destination "$_tgt" 2>/dev/null
}

# --- Main --------------------------------------------------------------------

case "$1" in
    start)
        is_running && exit 0
        $BIN -c "$CONF" -w "$WORKDIR" --no-check-update >> "$LOG" 2>&1 &

        init_rundir

        if wait_for_rci_ready; then
            _mark=$(resolve_policy_mark)
            if [ -n "$_mark" ]; then
                printf '%s\n' "$_mark" > "$MARKFILE"
                chmod 600 "$MARKFILE"
                logger -t adguardhome "policy mark: 0x$_mark"
            else
                logger -t adguardhome "policy '$AG_POLICY_NAME' not found in RCI"
            fi
        else
            logger -t adguardhome "RCI not ready after ${RCI_TIMEOUT}s"
        fi

        # NDM may have already finished its netfilter.d invocations before
        # mark became available; apply rules explicitly.
        [ -x "$HOOK" ] && table=nat "$HOOK" start
        ;;
    stop)
        remove_dns_rules
        clear_runtime
        killall AdGuardHome 2>/dev/null
        ;;
    restart)
        remove_dns_rules
        clear_runtime
        killall AdGuardHome 2>/dev/null
        sleep 1
        $0 start
        ;;
    status)
        is_running && echo "Running" || echo "Stopped"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
exit 0
